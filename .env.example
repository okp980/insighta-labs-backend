# GitHub OAuth (browser) — create an OAuth App; callback must match GITHUB_REDIRECT_URI
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback

# JWT signing + Starlette session secret (use a long random string in production)
SECRET=change-me-to-a-long-random-string

# SPA URL after OAuth (must match Authlib redirect target in code)
FRONTEND_URL=http://localhost:5173

# Comma-separated browser origins allowed by CORS
CORS_ALLOW_ORIGINS=http://localhost:5173

# Cookie flags — set COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional: separate GitHub OAuth app for CLI / native PKCE (leave blank if unused)
GITHUB_CLI_CLIENT_ID=
GITHUB_CLI_CLIENT_SECRET=
GITHUB_CLI_REDIRECT_URI=http://127.0.0.1:42069/callback

# PostgreSQL (SQLAlchemy URL). Example: local Docker postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/insighta

DATABASE_URL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
PROFILES_CACHE_TTL_SECONDS=
PROFILES_CACHE_MAX_ENTRIES=
CSV_IMPORT_BATCH_SIZE=
